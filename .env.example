# ============================================================================
# LLM Provider Configuration
# ============================================================================
# BASE_URL and API_KEY are the standard configurations for model call authentication.
# These variables support OpenAI, Gemini, LM Studio, Ollama, and other providers.

BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-openai-api-key-here

# Advertising auto workflow only: replace with tool-capable model aliases
# that your gateway actually exposes. The main workflow keeps per-node models.
# MODEL_STRONG=your-tool-capable-strategy-model
# MODEL_CHEAP=your-tool-capable-planning-model
# MODEL_REVIEW=your-tool-capable-review-model

# Disabled by default. Enable only for trusted workflows; this is not a sandbox.
# Covers Python nodes, code_save_and_run, execute_code, uv tools, Manim, and local MCP.
# Set in the server environment; workflow vars and tool env overrides cannot enable it.
MAC_ALLOW_UNSAFE_CODE_EXECUTION=0

# Example BASE_URL values:
# - OpenAI:    https://api.openai.com/v1
# - Gemini:    https://generativelanguage.googleapis.com
# - LM Studio: http://localhost:1234/v1
# - Ollama:    http://localhost:11434/v1

# ============================================================================
# Optional: Web Search and Reading Tools
# ============================================================================

# SERPER_DEV_API_KEY=your-serper-api-key-here
# Get from: https://serper.dev

# JINA_API_KEY=your-jina-api-key-here
# Get from: https://jina.ai

# Optional Banner_Producer: 9Router image API, AFTER plan approval.
# Enabled only by an explicit opt-in; 0 sends no image generation requests.
AD_BANNER_ENABLED=0
# Node defaults: model ag/gemini-3.1-flash-image, 2 banners, 2 requests/session.
# Endpoint/key fall back to existing BASE_URL/API_KEY. Never commit a real key.
# AD_BANNER_BASE_URL=http://127.0.0.1:20128/v1
# AD_BANNER_API_KEY=your-local-9router-key
# Requests use POST /images/generations with response_format=b64_json.
